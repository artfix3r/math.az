# Copy to .env for local development. Set the same values in Vercel / Render.

# --- Required ---
# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/mathaz
# Signs login cookies. At least 32 random characters; generate with:
#   openssl rand -hex 32
# Changing it signs everyone out. Required when NODE_ENV=production.
SESSION_SECRET=

# --- File storage (Supabase) ---
# Uploaded materials are stored in a private Supabase Storage bucket.
# Without these, small files (up to 3 MB) are stored in the database instead.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret / service_role key: server only, never put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable / anon key (safe to expose; optional).
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=materials

# --- Homework reminders ---
# Shared secret for POST /api/cron/reminders, called hourly by a scheduled job
# (Supabase pg_cron + pg_net) with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Optional ---
# Comma-separated emails of site admins who may read submitted feedback.
ADMIN_EMAILS=
# Public URL of the site, used in password-reset emails.
APP_BASE_URL=http://localhost:5000
# Google Sign-In (same OAuth client id on server and client).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Gmail account used to send password-reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional Formspree-style endpoint that feedback is forwarded to.
FEEDBACK_FORM_ENDPOINT=
