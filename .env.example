# Copy to .env for local development. Set the same values in Vercel / Render.

# --- Required ---
# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/mathaz
# Signs login cookies. At least 32 random characters; generate with:
#   openssl rand -hex 32
# Changing it signs everyone out. Required when NODE_ENV=production.
SESSION_SECRET=

# --- Teacher accounts ---
# Code a person must enter to sign up as a teacher. If empty, nobody can
# create a new teacher account (student sign-up always works).
TEACHER_SIGNUP_CODE=

# --- Optional ---
# Public URL of the site, used in password-reset emails.
APP_BASE_URL=http://localhost:5000
# Google Sign-In (same OAuth client id on server and client).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Gmail account used to send password-reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional Formspree-style endpoint that feedback is forwarded to.
FEEDBACK_FORM_ENDPOINT=
